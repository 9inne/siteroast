# Copy to .env.local for local dev. On Netlify, add these under Site settings → Environment variables.

# Your site's public address (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://siteroast.app

# Google PageSpeed Insights API key (browser key, restricted to your domain)
NEXT_PUBLIC_PSI_KEY=

# Supabase (Project settings → API). The secret key stays on the server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Claude API key for the roast copy. Without it, rule-based copy is used.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Any long random string, used to hash visitor IPs for rate limiting
IP_SALT=

# Optional: email you each new quote request via Brevo
BREVO_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_SENDER_EMAIL=
